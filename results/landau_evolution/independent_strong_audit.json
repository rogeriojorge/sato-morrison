  "derivation": {
    "density": "F_A(v)=(2pi)^(-3/2)det(A)^(-1/2)exp[-(v-U)^T A^-1(v-U)/2], number1.",
    "diffusion": "D(v)=integral U_L(v-vprime)F_A(vprime)d3vprime, U_L(w)=(I-wwT/r\u00b2)/r.",
    "IBP": "integral U_L gradprime Fprime=div_v D; C=Gamma div_v[F(D s-div D)], s=-A^-1(v-U).",
    "distribution_identity": "div div U_L=-8pi delta, so C/F=Gamma[D:(ssT-A^-1)+8pi F].",
    "Laplace": "D=(2/sqrtpi)integral_0^infinity Z[I-2s\u00b2(V+mmT)]ds; d_i=1+2A_i s\u00b2, V_i=A_i/d_i, m_i=(v_i-U_i)/d_i, Z=product(d_i)^(-1/2)exp[-s\u00b2 sum((v_i-U_i)\u00b2/d_i)].",
    "normalization": "For number density n, F includes n and D includes n. Normalized frequency is Gamma_SI*n/v0\u00b3; Gamma_SI=q\u2074lnLambda/(8pi epsilon0\u00b2m\u00b2).",
    "finite_weak": "Gaussian scores exact for all checked D: fdot=-D_vector^T[Gamma n_i sum_j n_j U_L(v_i-v_j)(score_i-score_j)]/w_i, n_i=w_iF_i; self pairs zero.",
    "metrics": "C/F RMS error=sqrt(sum_i w_iF_i(fdot_i/F_i-C_i/F_i)\u00b2); weighted L1=sum_i w_i|fdot_i-C_i| /sum_i w_i|C_i|. Core r<=3, tail r>3, boundary max|v_coordinate|>=4.",
    "derivative_scope": "Polynomial coefficient constraints define global and local3/5-point rows independently. Local quartic is a private diagnostic, not a production option."
  },
